---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Feliz Cumpleaños Annarella</title>
    <!-- FUENTES "CUCHI" Y ROMÁNTICAS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@500;700;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Capa 0: Fondo oscuro -->
    <div class="nebulosa" id="nebulosa"></div>
    
    <!-- Capa 1: Estrellas de fondo 2D -->
    <canvas id="universo-fondo"></canvas>

    <!-- Capa 2: Motor 3D -->
    <div id="contenedor-3d"></div>
    
    <!-- Capa 3: Lluvia de Meteoritos -->
    <div id="lluvia-meteoritos">
      <div class="estrella-fugaz fugaz-1"></div>
      <div class="estrella-fugaz fugaz-2"></div>
      <div class="estrella-fugaz fugaz-3"></div>
      <div class="meteorito meteoro-1"></div>
    </div>

    <!-- REPRODUCTOR YOUTUBE INVISIBLE -->
    <div id="yt-player" style="position: absolute; top: -9999px; left: -9999px;"></div>
    <button id="btn-musica" class="btn-flotante">🎵 Activar Música</button>

    <!-- Capa 4: Interfaz de Cumpleaños -->
    <div class="ui-contenedor" id="ui-textos">
      <img src="foto-annarella.jpg" alt="Annarella" id="foto-annarella" />
      
      <div class="mensaje-elegante" id="texto-cumple">
        <span class="feliz">FELIZ</span>
        <span class="cumple">CUMPLEAÑOS</span>
        <span class="nombre">Annarella</span>
      </div>
    </div>

    <button id="btn-galaxia" class="oculto">PRESIONA AQUÍ ✨</button>

    <!-- Capa 5: Interfaz de la Galaxia -->
    <div class="ui-galaxia oculto-total" id="ui-galaxia">
      <p class="mensaje-romantico">
        "El amor que siento por ti, no cabe ni en toda una galaxia... esta creación te la hago para expresar un pequeño porcentaje de mi amor por ti."
      </p>
      <button id="btn-constelacion">DESCUBRE TU REGALO 💖</button>
    </div>

    <!-- Capa 6: Interfaz Constelación de Libra -->
    <div class="ui-constelacion oculto-total" id="ui-constelacion">
      <h2 class="titulo-constelacion">Constelación de Libra ♎</h2>
      <p class="mensaje-regalo">
        Tu regalo físico está esperando por ti. 🎁<br><br>
        Como pensábamos que te ibas de viaje el martes, decidimos resguardarlo, pero será entregado en el momento exacto que tú lo solicites.<br><br>
        Si deseas que te lo entreguemos personalmente, por favor escribe a este número:
      </p>
      <!-- NÚMERO DE TELÉFONO INTEGRADO -->
      <a href="https://wa.me/5804247545638" target="_blank" class="numero-whatsapp">📱 0424-7545638</a>
      
      <button id="btn-volver">VOLVER AL INICIO 🌸</button>
    </div>

    <main class="contenedor-scroll" id="zona-scroll">
      <div class="indicador" id="indicador-scroll">
        <h1>Baja para ver la sorpresa 👇</h1>
      </div>
    </main>

    <!-- CARGA DE APIS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.min.js"></script>
    <script is:inline src="https://www.youtube.com/iframe_api"></script>

    <script is:inline>
      // @ts-nocheck
      // ==========================================
      // CONTROL DE MÚSICA
      // ==========================================
      const btnMusica = document.getElementById('btn-musica');
      let musicaActiva = false;
      let ytPlayer = null;

      window.onYouTubeIframeAPIReady = function() {
        ytPlayer = new window.YT.Player('yt-player', {
          height: '0', width: '0',
          videoId: 'FMzsC-2aVtU', 
          playerVars: { 'autoplay': 0, 'controls': 0, 'loop': 1, 'playlist': 'FMzsC-2aVtU' }
        });
      };

      btnMusica.addEventListener('click', () => {
        if (!ytPlayer || typeof ytPlayer.playVideo !== 'function') return;
        if (musicaActiva) {
          ytPlayer.pauseVideo();
          btnMusica.innerHTML = '🎵 Activar Música';
          btnMusica.classList.remove('activo');
        } else {
          ytPlayer.setVolume(100);
          ytPlayer.playVideo();
          btnMusica.innerHTML = '🔊 Música On';
          btnMusica.classList.add('activo');
        }
        musicaActiva = !musicaActiva;
      });

      // ==========================================
      // MOTOR 3D: GALAXIA MÁGICA DE POLVO DE ESTRELLAS
      // ==========================================
      const THREE = window.THREE; 
      const contenedor3D = document.getElementById('contenedor-3d');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight); 
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); 
      contenedor3D.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6); scene.add(ambientLight);
      const sunLight = new THREE.DirectionalLight(0xffffff, 2.5); sunLight.position.set(-10, 10, 10); scene.add(sunLight);
      const pinkLight = new THREE.PointLight(0xff1493, 2, 20); pinkLight.position.set(5, 0, 5); scene.add(pinkLight);

      // --- GENERADOR DE TEXTURAS ---
      function crearTexturaEmoji(emoji) {
          const canvas = document.createElement('canvas');
          canvas.width = 128; canvas.height = 128;
          const ctx = canvas.getContext('2d');
          ctx.font = '80px sans-serif';
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.shadowColor = 'rgba(255,255,255,0.8)'; ctx.shadowBlur = 15;
          ctx.fillText(emoji, 64, 70);
          return new THREE.CanvasTexture(canvas);
      }
      const texCorazon = crearTexturaEmoji('💖');
      const texFlor = crearTexturaEmoji('🌸');
      const texBrillo = crearTexturaEmoji('✨');

      // --- 1. SISTEMA INICIAL: CORAZÓN 3D DE CRISTAL ---
      const corazonesGroup = new THREE.Group();
      scene.add(corazonesGroup);

      const heartShape = new THREE.Shape();
      heartShape.moveTo(0, 1.5);
      heartShape.bezierCurveTo(2, 1.5, 2, -1, 0, -3);
      heartShape.bezierCurveTo(-2, -1, -2, 1.5, 0, 1.5);
      
      const extrudeSettings = { depth: 0.5, bevelEnabled: true, bevelSegments: 4, steps: 2, bevelSize: 0.3, bevelThickness: 0.3 };
      const heartGeo = new THREE.ExtrudeGeometry(heartShape, extrudeSettings);
      heartGeo.center(); 

      const heartMat = new THREE.MeshPhysicalMaterial({ 
          color: 0xff69b4, metalness: 0.2, roughness: 0.1, clearcoat: 1.0, clearcoatRoughness: 0.1, emissive: 0x330011 
      });
      const miniHeartMat = new THREE.MeshPhysicalMaterial({ 
          color: 0xffb6c1, metalness: 0.3, roughness: 0.2, clearcoat: 1.0 
      });

      const corazonCentral = new THREE.Mesh(heartGeo, heartMat);
      corazonCentral.scale.set(0.8, 0.8, 0.8);
      corazonesGroup.add(corazonCentral);

      const pequenosCorazones = [];
      for(let i=0; i<8; i++) {
          const miniC = new THREE.Mesh(heartGeo, miniHeartMat);
          miniC.scale.set(0.15, 0.15, 0.15);
          const angulo = (i / 8) * Math.PI * 2;
          const distancia = 3.5 + Math.random() * 1.5;
          miniC.position.set(Math.cos(angulo)*distancia, (Math.random()-0.5)*3, Math.sin(angulo)*distancia);
          corazonesGroup.add(miniC);
          pequenosCorazones.push({ mesh: miniC, angulo: angulo, distancia: distancia, velocidad: 0.01 + Math.random() * 0.02 });
      }

      // --- SHADER ESTRELLAS ÉPICAS ---
      const starUniforms = { uTime: { value: 0 } };
      const materialEstrellas = new THREE.ShaderMaterial({
          uniforms: starUniforms,
          vertexShader: `
              attribute float size; attribute float phase; varying vec3 vColor; varying float vAlpha; uniform float uTime;
              void main() {
                  vColor = color; float twinkle = (sin(uTime * 3.0 + phase) + 1.0) * 0.5; vAlpha = 0.5 + (twinkle * 0.8); 
                  vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                  gl_PointSize = size * (50.0 / -mvPosition.z); gl_Position = projectionMatrix * mvPosition;
              }
          `,
          fragmentShader: `
              varying vec3 vColor; varying float vAlpha;
              void main() {
                  float dist = length(gl_PointCoord - vec2(0.5)); if (dist > 0.5) discard;
                  float glow = exp(-dist * dist * 20.0); float finalAlpha = max(glow, 0.2) * vAlpha;
                  gl_FragColor = vec4(vColor, finalAlpha);
              }
          `,
          transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, vertexColors: true
      });

      // --- 2. LA GALAXIA ELEGANTE (SIN EMOJIS, SOLO POLVO MÁGICO) ---
      const galaxiaGroup = new THREE.Group();
      scene.add(galaxiaGroup);
      galaxiaGroup.visible = false; galaxiaGroup.position.z = -150; galaxiaGroup.rotation.x = 1.0; 

      function crearGalaxiaMágica(cantidad, radioGalaxia) {
          const geo = new THREE.BufferGeometry();
          const pos = new Float32Array(cantidad * 3), col = new Float32Array(cantidad * 3), siz = new Float32Array(cantidad), pha = new Float32Array(cantidad);
          
          const colorCentro = new THREE.Color(0xffffff); // Blanco puro luminoso
          const colorRosa = new THREE.Color(0xff99cc);   // Rosa pastel
          const colorLila = new THREE.Color(0xcc99ff);   // Lila hermoso
          const colorAzul = new THREE.Color(0x99ccff);   // Azulito suave
          
          for(let i = 0; i < cantidad; i++) {
              const distribucion = Math.pow(Math.random(), 3.0); 
              const radio = distribucion * radioGalaxia; 
              
              const angulo = (i % 5) * ((Math.PI * 2) / 5);
              const giro = radio * 0.45; 
              const dispersionRadio = 4.5; 
              const dispersionX = (Math.random() - 0.5) * (radio / radioGalaxia) * dispersionRadio * 2;
              const dispersionZ = (Math.random() - 0.5) * (radio / radioGalaxia) * dispersionRadio * 2;
              const alturaBulge = (Math.random() - 0.5) * 6.0 * Math.exp(-radio/2);

              pos[i*3] = Math.cos(angulo + giro) * radio + dispersionX;
              pos[i*3+1] = alturaBulge;
              pos[i*3+2] = Math.sin(angulo + giro) * radio + dispersionZ;
              
              let mixedColor = colorCentro.clone();
              if(radio > 1.0) {
                  const colorBrazo = i % 2 === 0 ? colorRosa : (i % 3 === 0 ? colorAzul : colorLila);
                  mixedColor.lerp(colorBrazo, radio / (radioGalaxia * 0.8));
              }
              let intensidad = Math.max(0.3, 1.5 - (radio / radioGalaxia));
              mixedColor.multiplyScalar(intensidad);

              col[i*3] = mixedColor.r; col[i*3+1] = mixedColor.g; col[i*3+2] = mixedColor.b;
              // Estrellas finas y elegantes
              siz[i] = Math.random() * 2.5 + 0.8; 
              pha[i] = Math.random() * Math.PI * 2;
          }
          geo.setAttribute('position', new THREE.BufferAttribute(pos, 3)); geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
          geo.setAttribute('size', new THREE.BufferAttribute(siz, 1)); geo.setAttribute('phase', new THREE.BufferAttribute(pha, 1));
          return geo;
      }
      galaxiaGroup.add(new THREE.Points(crearGalaxiaMágica(25000, 32), materialEstrellas));

      // --- 3. CONSTELACIÓN DE LIBRA ---
      const constelacionGroup = new THREE.Group();
      scene.add(constelacionGroup);
      constelacionGroup.position.z = -150; 
      constelacionGroup.visible = false;

      const p1 = new THREE.Vector3(-4, -2, 0); 
      const p2 = new THREE.Vector3(0, 3, 0);   
      const p3 = new THREE.Vector3(4, -2, 0);  
      const p4 = new THREE.Vector3(6, 1, 0);   
      const p5 = new THREE.Vector3(-6, 1, 0);  
      const libPuntos = [p1, p2, p3, p4, p5];
      const libLineas = [p5, p1, p1, p2, p2, p3, p3, p4, p1, p3]; 

      const particulasPorPunto = 30;
      const totalParticulas = 5 + (5 * particulasPorPunto);
      
      const constPos = new Float32Array(totalParticulas * 3);
      const constCol = new Float32Array(totalParticulas * 3); 
      const constSiz = new Float32Array(totalParticulas); 
      const constPha = new Float32Array(totalParticulas);

      let idx = 0;
      for(let i=0; i<5; i++) {
          constPos[idx*3] = libPuntos[i].x; constPos[idx*3+1] = libPuntos[i].y; constPos[idx*3+2] = libPuntos[i].z;
          constCol[idx*3] = 1; constCol[idx*3+1] = 1; constCol[idx*3+2] = 1; 
          constSiz[idx] = 25.0; 
          constPha[idx] = Math.random() * Math.PI;
          idx++;
          
          for(let j=0; j<particulasPorPunto; j++) {
              const r = Math.random() * 1.5; 
              const ang = Math.random() * Math.PI * 2;
              constPos[idx*3] = libPuntos[i].x + Math.cos(ang) * r; 
              constPos[idx*3+1] = libPuntos[i].y + Math.sin(ang) * r; 
              constPos[idx*3+2] = libPuntos[i].z + (Math.random()-0.5);
              
              const isPink = Math.random() > 0.5;
              constCol[idx*3] = isPink ? 1.0 : 1.0; 
              constCol[idx*3+1] = isPink ? 0.6 : 0.9; 
              constCol[idx*3+2] = isPink ? 0.8 : 0.5; 
              
              constSiz[idx] = Math.random() * 8.0 + 2.0; 
              constPha[idx] = Math.random() * Math.PI * 2; 
              idx++;
          }
      } 

      const constGeo = new THREE.BufferGeometry();
      constGeo.setAttribute('position', new THREE.BufferAttribute(constPos, 3));
      constGeo.setAttribute('color', new THREE.BufferAttribute(constCol, 3));
      constGeo.setAttribute('size', new THREE.BufferAttribute(constSiz, 1));
      constGeo.setAttribute('phase', new THREE.BufferAttribute(constPha, 1));
      constelacionGroup.add(new THREE.Points(constGeo, materialEstrellas)); 

      const lineGeo = new THREE.BufferGeometry().setFromPoints(libLineas);
      const lineMat = new THREE.LineBasicMaterial({ color: 0xff99cc, transparent: true, opacity: 0.8, linewidth: 3 });
      constelacionGroup.add(new THREE.LineSegments(lineGeo, lineMat));

      // --- LLUVIA DE FLORES Y CORAZONES 3D ---
      function crearParticulasCayendo(textura, count, size) {
          const geo = new THREE.BufferGeometry();
          const pos = new Float32Array(count * 3);
          const vel = new Float32Array(count * 3);
          for(let i=0; i<count; i++) {
              pos[i*3] = (Math.random() - 0.5) * 80; 
              pos[i*3+1] = (Math.random() - 0.5) * 80 + 40; 
              pos[i*3+2] = (Math.random() - 0.5) * 40 - 10; 
              vel[i*3] = (Math.random() - 0.5) * 0.02; 
              vel[i*3+1] = - (Math.random() * 0.04 + 0.02); 
              vel[i*3+2] = (Math.random() - 0.5) * 0.02; 
          }
          geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
          geo.setAttribute('velocity', new THREE.BufferAttribute(vel, 3));
          
          const mat = new THREE.PointsMaterial({ size: size, map: textura, transparent: true, depthWrite: false });
          return new THREE.Points(geo, mat);
      }

      const lluviaCorazones = crearParticulasCayendo(texCorazon, 40, 3.0);
      const lluviaFlores = crearParticulasCayendo(texFlor, 40, 3.0);
      const lluviaBrillos = crearParticulasCayendo(texBrillo, 60, 2.5);
      
      constelacionGroup.add(lluviaCorazones);
      constelacionGroup.add(lluviaFlores);
      constelacionGroup.add(lluviaBrillos);

      // --- SISTEMA DE CÁMARA Y NAVEGACIÓN ---
      let estado = 0; 
      let basePlanetY = 3;
      let targetPlanetY = basePlanetY;
      let targetGalaxiaZ = -150; 
      let targetConstelacionZ = -150;
      let targetCameraZ = 12;

      let mouseX = 0, mouseY = 0;
      document.addEventListener('mousemove', (e) => { mouseX = (e.clientX - window.innerWidth/2)*0.002; mouseY = (e.clientY - window.innerHeight/2)*0.002; });

      function actualizarLayout3D() {
          camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight);
          if (window.innerWidth < 768) { 
              basePlanetY = 4.5; corazonesGroup.position.set(1.2, basePlanetY, -4); corazonesGroup.scale.set(0.5, 0.5, 0.5); 
              galaxiaGroup.scale.set(0.6, 0.6, 0.6); constelacionGroup.scale.set(0.7, 0.7, 0.7); 
          } else { 
              basePlanetY = 3; corazonesGroup.position.set(4, basePlanetY, -2); corazonesGroup.scale.set(1, 1, 1); 
              galaxiaGroup.scale.set(1, 1, 1); constelacionGroup.scale.set(1, 1, 1); 
          }
          if(estado === 0) targetPlanetY = basePlanetY;
      }
      window.addEventListener('resize', actualizarLayout3D); actualizarLayout3D(); 

      const btnGalaxia = document.getElementById('btn-galaxia');
      const btnConstelacion = document.getElementById('btn-constelacion');
      const btnVolver = document.getElementById('btn-volver');
      let enViaje = false; 

      btnGalaxia.addEventListener('click', () => {
          if(enViaje) return; enViaje = true; estado = 1;
          
          document.getElementById('zona-scroll').style.display = 'none';
          document.getElementById('ui-textos').style.opacity = '0';
          btnGalaxia.classList.add('oculto');
          document.getElementById('lluvia-meteoritos').style.opacity = '0';
          document.getElementById('universo-fondo').style.opacity = '0';
          document.getElementById('nebulosa').style.opacity = '0'; 
          
          targetPlanetY = -40; 
          galaxiaGroup.visible = true; galaxiaGroup.position.z = -100; 
          targetGalaxiaZ = -3; targetCameraZ = 6; 
          
          setTimeout(() => { document.getElementById('ui-galaxia').classList.remove('oculto-total'); enViaje = false; }, 3000);
      });

      btnConstelacion.addEventListener('click', () => {
          if(enViaje) return; enViaje = true; estado = 2;
          
          document.getElementById('ui-galaxia').classList.add('oculto-total');
          targetGalaxiaZ = 20; 
          
          constelacionGroup.visible = true; constelacionGroup.position.z = -80; targetConstelacionZ = -6; 
          
          setTimeout(() => {
              galaxiaGroup.visible = false; 
              document.getElementById('ui-constelacion').classList.remove('oculto-total');
              enViaje = false;
          }, 2500);
      });

      btnVolver.addEventListener('click', () => {
          if(enViaje) return; enViaje = true; estado = 0;
          
          document.getElementById('ui-constelacion').classList.add('oculto-total');
          targetConstelacionZ = 20; 
          targetCameraZ = 12; targetPlanetY = basePlanetY; targetGalaxiaZ = -150; 
          
          setTimeout(() => {
              constelacionGroup.visible = false;
              document.getElementById('zona-scroll').style.display = 'block';
              document.getElementById('lluvia-meteoritos').style.opacity = '1';
              document.getElementById('universo-fondo').style.opacity = '1';
              document.getElementById('nebulosa').style.opacity = '1'; 
              document.getElementById('ui-textos').style.opacity = '1';
              window.dispatchEvent(new Event('scroll'));
              enViaje = false;
          }, 2500);
      });

      let tiempoShader = 0;
      
      function animarLluvia(puntos) {
          const posiciones = puntos.geometry.attributes.position.array;
          const velocidades = puntos.geometry.attributes.velocity.array;
          for(let i=0; i<posiciones.length/3; i++) {
              posiciones[i*3] += velocidades[i*3];
              posiciones[i*3+1] += velocidades[i*3+1]; 
              posiciones[i*3+2] += velocidades[i*3+2];
              if(posiciones[i*3+1] < -30) {
                  posiciones[i*3+1] = 40;
                  posiciones[i*3] = (Math.random() - 0.5) * 80;
              }
          }
          puntos.geometry.attributes.position.needsUpdate = true;
      }

      function animate3D() {
        requestAnimationFrame(animate3D);
        camera.position.x += (mouseX*2 - camera.position.x) * 0.05; camera.position.y += (-mouseY*2 - camera.position.y) * 0.05; camera.lookAt(scene.position);

        camera.position.z += (targetCameraZ - camera.position.z) * 0.04;
        corazonesGroup.position.y += (targetPlanetY - corazonesGroup.position.y) * 0.03;
        
        galaxiaGroup.position.z += (targetGalaxiaZ - galaxiaGroup.position.z) * 0.03;
        constelacionGroup.position.z += (targetConstelacionZ - constelacionGroup.position.z) * 0.04;

        corazonCentral.rotation.y += 0.01;
        corazonCentral.position.y = Math.sin(Date.now() * 0.002) * 0.2; 
        
        pequenosCorazones.forEach(pc => {
            pc.angulo += pc.velocidad;
            pc.mesh.position.x = Math.cos(pc.angulo) * pc.distancia;
            pc.mesh.position.z = Math.sin(pc.angulo) * pc.distancia;
            pc.mesh.rotation.x += 0.02;
            pc.mesh.rotation.y += 0.03;
        });
        
        tiempoShader += 0.01; starUniforms.uTime.value = tiempoShader;

        if(galaxiaGroup.visible) { galaxiaGroup.rotation.y += 0.0015; galaxiaGroup.rotation.z += 0.0005; }
        
        if(constelacionGroup.visible) { 
            animarLluvia(lluviaCorazones);
            animarLluvia(lluviaFlores);
            animarLluvia(lluviaBrillos);
        }

        renderer.render(scene, camera);
      }
      animate3D();

      // ==========================================
      // CONTROLADOR DE SCROLL 2D
      // ==========================================
      const canvasFondo = document.getElementById('universo-fondo');
      const ctxFondo = canvasFondo.getContext('2d');
      const foto = document.getElementById('foto-annarella');
      const textoCumple = document.getElementById('texto-cumple');
      const btnGalaxiaScroll = document.getElementById('btn-galaxia');
      const indicadorScroll = document.getElementById('indicador-scroll');
      
      let width, height, estrellasFondo = []; 
      function iniciarFondo() {
        width = canvasFondo.width = window.innerWidth; height = canvasFondo.height = window.innerHeight; estrellasFondo = [];
        for (let i = 0; i < (width < 768 ? 150 : 300); i++) estrellasFondo.push({ x: Math.random() * width, y: Math.random() * height, tamano: Math.random() * 1.5, faseBrillo: Math.random() * Math.PI * 2, velocidadBrillo: Math.random() * 0.5 + 0.2 });
      }
      
      window.addEventListener('scroll', () => {
        if(estado !== 0) return;
        const scrollMaximo = document.body.scrollHeight - window.innerHeight;
        const p = Math.min(Math.max(window.scrollY / scrollMaximo, 0), 1);
        
        indicadorScroll.style.opacity = p > 0.05 ? '0' : '0.7';
        
        let pFoto = Math.min(Math.max((p - 0.2) * 2, 0), 1);
        foto.style.opacity = pFoto; foto.style.transform = `translate(-50%, ${50 - pFoto*50}px) scale(${0.8 + pFoto*0.2})`;
        
        let pTexto = Math.min(Math.max((p - 0.5) * 2.5, 0), 1);
        textoCumple.style.opacity = pTexto; textoCumple.style.transform = `translate(-50%, ${30 - pTexto*30}px) scale(${0.9 + pTexto*0.1})`;

        if (p > 0.85) { btnGalaxiaScroll.classList.remove('oculto'); btnGalaxiaScroll.style.pointerEvents = 'auto'; } 
        else { btnGalaxiaScroll.classList.add('oculto'); btnGalaxiaScroll.style.pointerEvents = 'none'; }
      });

      function animarFondo() {
        ctxFondo.clearRect(0, 0, width, height); const t = Date.now() * 0.001; 
        estrellasFondo.forEach(e => {
          ctxFondo.fillStyle = `rgba(255, 182, 193, ${0.3 + (Math.sin(t * e.velocidadBrillo + e.faseBrillo) * 0.4)})`; 
          ctxFondo.beginPath(); ctxFondo.arc(e.x, e.y, e.tamano, 0, Math.PI * 2); ctxFondo.fill();
        }); requestAnimationFrame(animarFondo);
      }
      window.addEventListener('resize', iniciarFondo); iniciarFondo(); animarFondo();
    </script>
  </body>
</html>

