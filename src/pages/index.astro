---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Feliz Cumpleaños Annarella</title>
    
    <!-- FUENTES "CUCHI" Y ROMÁNTICAS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@500;700;900&display=swap" rel="stylesheet">
  
    <!-- ESTILO INCRUSTADO PARA EVITAR EL BLOQUEO DE GITHUB PAGES -->
    <style is:inline>
      body, html { margin: 0; padding: 0; background-color: #0b0212; color: white; font-family: 'Quicksand', sans-serif; overflow-x: hidden; }
      
      .pantalla-magica {
          position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
          background: radial-gradient(circle, #2b0b3a 0%, #0b0212 100%);
          z-index: 999999; display: flex; flex-direction: column; justify-content: center; align-items: center;
          transition: opacity 1s ease;
      }
      .pantalla-magica h1 { font-family: 'Dancing Script', cursive; font-size: clamp(3rem, 8vw, 5rem); color: #ffb6c1; margin-bottom: 10px; text-align: center; }
      .pantalla-magica p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 40px; }
      .btn-comenzar { 
          font-family: 'Quicksand', sans-serif; font-weight: 800; font-size: 1.2rem;
          color: white; background: linear-gradient(45deg, #ff758c, #ff7eb3);
          padding: 15px 40px; border: none; border-radius: 50px; cursor: pointer;
          box-shadow: 0 10px 20px rgba(255, 117, 140, 0.4), 0 0 30px rgba(255, 126, 179, 0.4);
          animation: palpitar 2s infinite; transition: transform 0.3s;
      }
      .btn-comenzar:hover { transform: scale(1.1); }

      .nebulosa { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at 20% 30%, rgba(90, 20, 80, 0.4) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(40, 20, 100, 0.3) 0%, transparent 50%), radial-gradient(circle at 50% 100%, rgba(120, 20, 60, 0.25) 0%, transparent 60%); z-index: 0; transition: opacity 1.5s ease; }
      #universo-fondo { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; transition: opacity 1.5s ease; }
      #contenedor-3d { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; }
      #lluvia-meteoritos { z-index: 3; pointer-events: none; transition: opacity 1.5s ease; }
      
      .btn-flotante { position: fixed; top: 20px; right: 20px; z-index: 100; background: rgba(255, 182, 193, 0.15); backdrop-filter: blur(10px); border: 1px solid rgba(255, 182, 193, 0.4); color: #fff0f5; padding: 10px 20px; border-radius: 30px; font-family: 'Quicksand', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; box-shadow: 0 0 15px rgba(255, 105, 180, 0.3); transition: all 0.3s ease; }
      .btn-flotante:hover { background: rgba(255, 182, 193, 0.3); transform: scale(1.05); }
      .btn-flotante.activo { background: rgba(255, 105, 180, 0.5); border-color: #ff69b4; box-shadow: 0 0 20px rgba(255, 105, 180, 0.8); }

      .ui-contenedor { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 10; pointer-events: none; transition: opacity 1s ease; }
      #foto-annarella { position: absolute; top: 15vh; left: 50%; transform: translate(-50%, 50px); width: clamp(160px, 40vw, 300px); height: clamp(160px, 40vw, 300px); object-fit: cover; border-radius: 50%; box-shadow: 0 0 40px rgba(255, 105, 180, 0.6), 0 0 80px rgba(255, 182, 193, 0.4); border: 5px solid rgba(255, 240, 245, 0.9); opacity: 0; transition: transform 0.1s linear, opacity 0.1s linear; }

      .mensaje-elegante { position: absolute; top: calc(15vh + clamp(160px, 40vw, 300px) + 20px); left: 50%; transform: translate(-50%, 30px); text-align: center; display: flex; flex-direction: column; gap: 5px; opacity: 0; transition: transform 0.1s linear, opacity 0.1s linear; }
      .mensaje-elegante span { line-height: 1; letter-spacing: 2px; text-shadow: 0 0 20px rgba(255, 105, 180, 0.8), 0 0 40px rgba(255, 182, 193, 0.6); }
      .feliz { font-family: 'Quicksand', sans-serif; font-size: clamp(1.5rem, 6vw, 3rem); font-weight: 700; color: #fff; }
      .cumple { font-family: 'Quicksand', sans-serif; font-size: clamp(2rem, 8vw, 4rem); font-weight: 900; color: #fff; background: -webkit-linear-gradient(45deg, #ff758c, #ff7eb3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .nombre { font-family: 'Dancing Script', cursive; font-size: clamp(3rem, 12vw, 6rem); text-transform: capitalize; color: #ffebf0; text-shadow: 0 0 30px rgba(255, 105, 180, 1); margin-top: -10px; }

      #btn-galaxia, #btn-constelacion, #btn-volver { 
          font-family: 'Quicksand', sans-serif; font-weight: 800; font-size: 1.1rem; letter-spacing: 1px;
          color: white; background: linear-gradient(45deg, #ff758c 0%, #ff7eb3 100%);
          border: 2px solid rgba(255,255,255,0.4); border-radius: 50px; cursor: pointer; pointer-events: auto; touch-action: manipulation;
          box-shadow: 0 10px 20px rgba(255, 117, 140, 0.4), 0 0 30px rgba(255, 126, 179, 0.4);
          transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
      }
      #btn-galaxia { position: fixed; bottom: 10vh; left: 50%; transform: translateX(-50%); padding: 15px 40px; z-index: 9999; animation: flotarBtn 3s infinite ease-in-out; }
      #btn-constelacion, #btn-volver { padding: 15px 35px; margin-top: 20px; }
      
      #btn-galaxia:hover, #btn-constelacion:hover, #btn-volver:hover { transform: translateX(-50%) translateY(-5px); box-shadow: 0 15px 25px rgba(255, 117, 140, 0.6), 0 0 50px rgba(255, 126, 179, 0.6); background: linear-gradient(45deg, #ff7eb3 0%, #ff758c 100%); }
      #btn-galaxia.oculto { opacity: 0; pointer-events: none !important; transform: translateX(-50%) translateY(30px); }

      @keyframes flotarBtn { 0% { transform: translateX(-50%) translateY(0px); } 50% { transform: translateX(-50%) translateY(-8px); box-shadow: 0 15px 25px rgba(255, 117, 140, 0.5), 0 0 40px rgba(255, 126, 179, 0.6); } 100% { transform: translateX(-50%) translateY(0px); } }

      .ui-galaxia, .ui-constelacion { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 60; display: flex; flex-direction: column; justify-content: center; align-items: center; background: radial-gradient(circle, rgba(20,5,30,0.6) 0%, transparent 90%); transition: opacity 1.5s ease, transform 1.5s ease; }
      .oculto-total { opacity: 0; transform: scale(1.05); pointer-events: none; }
      
      .mensaje-romantico { width: 85%; max-width: 600px; text-align: center; font-family: 'Quicksand', sans-serif; font-size: clamp(1.2rem, 4.5vw, 1.8rem); font-weight: 600; line-height: 1.6; color: #fff0f5; text-shadow: 0 0 15px rgba(255, 105, 180, 0.8), 0 0 30px rgba(255, 182, 193, 0.6); margin-bottom: 30px; }
      
      .titulo-constelacion { font-family: 'Dancing Script', cursive; font-size: clamp(3rem, 10vw, 5rem); color: #ffb6c1; text-shadow: 0 0 25px #ff69b4, 0 0 50px #ff1493; margin-bottom: 20px; font-weight: 700; text-align: center; line-height: 1.2; }
      
      .mensaje-regalo { width: 85%; max-width: 550px; text-align: center; font-family: 'Quicksand', sans-serif; font-size: clamp(1rem, 3.8vw, 1.3rem); font-weight: 500; line-height: 1.6; color: #ffe4e1; text-shadow: 0 0 10px rgba(255, 182, 193, 0.5); margin-bottom: 30px; background: rgba(255, 192, 203, 0.1); padding: 20px; border-radius: 20px; backdrop-filter: blur(5px); border: 1px solid rgba(255, 182, 193, 0.2); }
      
      .numero-whatsapp { font-family: 'Quicksand', sans-serif; font-size: clamp(1.2rem, 4.5vw, 1.8rem); font-weight: 800; color: #fff; text-decoration: none; padding: 12px 30px; background: linear-gradient(45deg, #25D366, #1da851); border-radius: 30px; margin-bottom: 30px; transition: all 0.3s ease; box-shadow: 0 10px 20px rgba(37, 211, 102, 0.4), 0 0 30px rgba(37, 211, 102, 0.6); }
      .numero-whatsapp:hover { transform: scale(1.05) translateY(-3px); box-shadow: 0 15px 25px rgba(37, 211, 102, 0.5), 0 0 40px rgba(37, 211, 102, 0.8); }

      .contenedor-scroll { position: relative; height: 350vh; z-index: 20; }
      .indicador { position: fixed; top: 5%; width: 100%; text-align: center; pointer-events: none; transition: opacity 0.5s; text-shadow: 0px 0px 10px rgba(255,255,255,0.5); }

      .estrella-fugaz, .meteorito { position: fixed; border-radius: 50%; opacity: 0; }
      .estrella-fugaz { width: 3px; height: 3px; background: #fff0f5; box-shadow: 0 0 10px #fff0f5; }
      .estrella-fugaz::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 150px; height: 1px; background: linear-gradient(90deg, rgba(255,182,193,0.8), transparent); }
      .meteorito { width: 6px; height: 6px; background: #ff9a9e; box-shadow: 0 0 20px #ff9a9e, 0 0 40px #fecfef; }
      .meteorito::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 250px; height: 3px; background: linear-gradient(90deg, #ff9a9e, #ffb6c1, transparent); }

      .fugaz-1 { top: 20%; left: 100%; animation: animarFugaz 7s linear infinite; animation-delay: 1s; }
      .fugaz-2 { top: 60%; left: 110%; animation: animarFugaz 11s linear infinite; animation-delay: 4s; }
      .fugaz-3 { top: 85%; left: 120%; animation: animarFugaz 14s linear infinite; animation-delay: 8s; }
      .meteoro-1 { top: 15%; left: 130%; animation: animarFugaz 15s linear infinite; animation-delay: 5s; }

      @keyframes animarFugaz { 0% { transform: translateX(0) translateY(0) rotate(-35deg); opacity: 1; } 3% { opacity: 1; } 10% { opacity: 0; } 100% { transform: translateX(-2500px) translateY(1750px) rotate(-35deg); opacity: 0; } }

      @media (max-width: 768px) { .indicador h1 { font-size: 5vw; } .btn-flotante { top: 10px; right: 10px; font-size: 0.8rem; padding: 8px 15px; } }
    </style>
  </head>
  <body>
    <!-- Pantalla inicial para saltar el bloqueo de audio del navegador -->
    <div id="pantalla-bloqueo" class="pantalla-magica">
      <h1>¡Tengo una sorpresa para ti!</h1>
      <p>Asegúrate de tener el volumen encendido...</p>
      <button id="btn-comenzar" class="btn-comenzar">✨ TOCA AQUÍ PARA ENTRAR ✨</button>
    </div>

    <!-- Capa 0: Fondo oscuro -->
    <div class="nebulosa" id="nebulosa"></div>
    
    <!-- Capa 1: Estrellas de fondo 2D -->
    <canvas id="universo-fondo"></canvas>

    <!-- Capa 2: Motor 3D -->
    <div id="contenedor-3d"></div>
    
    <!-- Capa 3: Lluvia de Meteoritos -->
    <div id="lluvia-meteoritos">
      <div class="estrella-fugaz fugaz-1"></div>
      <div class="estrella-fugaz fugaz-2"></div>
      <div class="estrella-fugaz fugaz-3"></div>
      <div class="meteorito meteoro-1"></div>
    </div>

    <!-- REPRODUCTOR YOUTUBE INVISIBLE Y MIXER -->
    <div id="yt-player" style="position: absolute; top: -9999px; left: -9999px;"></div>
    <button id="btn-musica" class="btn-flotante activo">🔊 Música On</button>

    <!-- Capa 4: Interfaz de Cumpleaños -->
    <div class="ui-contenedor" id="ui-textos">
      <img src="foto-annarella.jpg" alt="Annarella" id="foto-annarella" />
      
      <div class="mensaje-elegante" id="texto-cumple">
        <span class="feliz">FELIZ</span>
        <span class="cumple">CUMPLEAÑOS</span>
        <span class="nombre">Annarella</span>
      </div>
    </div>

    <button id="btn-galaxia" class="oculto">PRESIONA AQUÍ ✨</button>

    <!-- Capa 5: Interfaz de la Galaxia -->
    <div class="ui-galaxia oculto-total" id="ui-galaxia">
      <p class="mensaje-romantico">
        "El amor que siento por ti, no cabe ni en toda una galaxia... esta creación te la hago para expresar un pequeño porcentaje de mi amor por ti."
      </p>
      <button id="btn-constelacion">DESCUBRE TU REGALO 💖</button>
    </div>

    <!-- Capa 6: Interfaz Constelación de Libra -->
    <div class="ui-constelacion oculto-total" id="ui-constelacion">
      <h2 class="titulo-constelacion">Constelación de Libra ♎</h2>
      <p class="mensaje-regalo">
        Como pensaba que ibas a irte de viaje hoy, tu regalo no está en tu casa. Quería que te llegara a la hora que siempre estás despierta, entonces decidí resguardarlo, pero será entregado en el momento exacto que lo solicites. 🎁<br><br>
        Si deseas que yo, Eliandro Madariaga, te lo entregue en persona, escribe a este número (el mío).<br>
        Si deseas que te llegue cuando quieras, escribe a este número:
      </p>
      <a href="https://wa.me/584247046806" target="_blank" class="numero-whatsapp">📱 0424-7046806</a>
      
      <button id="btn-volver">VOLVER AL INICIO 🌸</button>
    </div>

    <main class="contenedor-scroll" id="zona-scroll">
      <div class="indicador" id="indicador-scroll">
        <h1>Baja para ver la sorpresa 👇</h1>
      </div>
    </main>

    <!-- CARGA DE APIS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.min.js"></script>
    <script is:inline src="https://www.youtube.com/iframe_api"></script>

    <script is:inline>
      // @ts-nocheck
      // ==========================================
      // CONTROL DE MÚSICA - MIXER ROMÁNTICO
      // ==========================================
      const btnMusica = document.getElementById('btn-musica');
      const btnComenzar = document.getElementById('btn-comenzar');
      const pantallaBloqueo = document.getElementById('pantalla-bloqueo');
      let musicaActiva = false;
      let ytPlayer = null;

      const cancionesMix = [
        { id: '3xq3fbt0_Xc', start: 62 },  
        { id: 'QaFtF7XLEBI', start: 67 },  
        { id: 'HW9QTkAHvTs', start: 58 },  
        { id: 'GjE2bNYg6_I', start: 55 },  
        { id: 'N6czO5HSeFc', start: 45 },  
        { id: 'Ox-gYS0x4Nw', start: 45 }   
      ];
      let cancionActual = 0;

      window.onYouTubeIframeAPIReady = function() {
        ytPlayer = new window.YT.Player('yt-player', {
          height: '0', width: '0',
          videoId: cancionesMix[0].id, 
          playerVars: { 
              'autoplay': 0, 
              'controls': 0, 
              'start': cancionesMix[0].start,
              'rel': 0
          },
          events: {
              'onStateChange': onPlayerStateChange
          }
        });
      };

      function onPlayerStateChange(event) {
          if (event.data === window.YT.PlayerState.ENDED) {
              siguienteCancion();
          }
      }

      function siguienteCancion() {
          cancionActual++;
          if(cancionActual >= cancionesMix.length) cancionActual = 0; 
          ytPlayer.loadVideoById({
              videoId: cancionesMix[cancionActual].id,
              startSeconds: cancionesMix[cancionActual].start
          });
      }

      btnComenzar.addEventListener('click', () => {
          pantallaBloqueo.style.opacity = '0';
          setTimeout(() => { pantallaBloqueo.style.display = 'none'; }, 1000);
          
          if (ytPlayer && typeof ytPlayer.playVideo === 'function') {
              ytPlayer.setVolume(100);
              ytPlayer.playVideo();
              musicaActiva = true;
          }
      });

      btnMusica.addEventListener('click', () => {
        if (!ytPlayer || typeof ytPlayer.playVideo !== 'function') return;
        if (musicaActiva) {
          ytPlayer.pauseVideo();
          btnMusica.innerHTML = '🎵 Activar Música';
          btnMusica.classList.remove('activo');
        } else {
          ytPlayer.playVideo();
          btnMusica.innerHTML = '🔊 Música On';
          btnMusica.classList.add('activo');
        }
        musicaActiva = !musicaActiva;
      });

      // ==========================================
      // MOTOR 3D: GALAXIA MÁGICA
      // ==========================================
      const THREE = window.THREE; 
      const contenedor3D = document.getElementById('contenedor-3d');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight); 
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); 
      contenedor3D.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6); scene.add(ambientLight);
      const sunLight = new THREE.DirectionalLight(0xffffff, 2.5); sunLight.position.set(-10, 10, 10); scene.add(sunLight);
      const pinkLight = new THREE.PointLight(0xff1493, 2, 20); pinkLight.position.set(5, 0, 5); scene.add(pinkLight);

      function crearTexturaEmoji(emoji) {
          const canvas = document.createElement('canvas');
          canvas.width = 128; canvas.height = 128;
          const ctx = canvas.getContext('2d');
          ctx.font = '80px sans-serif';
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.shadowColor = 'rgba(255,255,255,0.8)'; ctx.shadowBlur = 15;
          ctx.fillText(emoji, 64, 70);
          return new THREE.CanvasTexture(canvas);
      }
      const texCorazon = crearTexturaEmoji('💖');
      const texFlor = crearTexturaEmoji('🌸');
      const texBrillo = crearTexturaEmoji('✨');

      // --- 1. SISTEMA INICIAL: CORAZÓN 3D DE CRISTAL ---
      const corazonesGroup = new THREE.Group();
      scene.add(corazonesGroup);

      const heartShape = new THREE.Shape();
      heartShape.moveTo(0, 1.5);
      heartShape.bezierCurveTo(2, 1.5, 2, -1, 0, -3);
      heartShape.bezierCurveTo(-2, -1, -2, 1.5, 0, 1.5);
      
      const extrudeSettings = { depth: 0.5, bevelEnabled: true, bevelSegments: 4, steps: 2, bevelSize: 0.3, bevelThickness: 0.3 };
      const heartGeo = new THREE.ExtrudeGeometry(heartShape, extrudeSettings);
      heartGeo.center(); 

      const heartMat = new THREE.MeshPhysicalMaterial({ 
          color: 0xff69b4, metalness: 0.2, roughness: 0.1, clearcoat: 1.0, clearcoatRoughness: 0.1, emissive: 0x330011 
      });
      const miniHeartMat = new THREE.MeshPhysicalMaterial({ 
          color: 0xffb6c1, metalness: 0.3, roughness: 0.2, clearcoat: 1.0 
      });

      const corazonCentral = new THREE.Mesh(heartGeo, heartMat);
      corazonCentral.scale.set(0.8, 0.8, 0.8);
      corazonesGroup.add(corazonCentral);

      const pequenosCorazones = [];
      for(let i=0; i<8; i++) {
          const miniC = new THREE.Mesh(heartGeo, miniHeartMat);
          miniC.scale.set(0.15, 0.15, 0.15);
          const angulo = (i / 8) * Math.PI * 2;
          const distancia = 3.5 + Math.random() * 1.5;
          miniC.position.set(Math.cos(angulo)*distancia, (Math.random()-0.5)*3, Math.sin(angulo)*distancia);
          corazonesGroup.add(miniC);
          pequenosCorazones.push({ mesh: miniC, angulo: angulo, distancia: distancia, velocidad: 0.01 + Math.random() * 0.02 });
      }

      const starUniforms = { uTime: { value: 0 } };
      const materialEstrellas = new THREE.ShaderMaterial({
          uniforms: starUniforms,
          vertexShader: `
              attribute float size; attribute float phase; varying vec3 vColor; varying float vAlpha; uniform float uTime;
              void main() {
                  vColor = color; float twinkle = (sin(uTime * 3.0 + phase) + 1.0) * 0.5; vAlpha = 0.5 + (twinkle * 0.8); 
                  vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                  gl_PointSize = size * (50.0 / -mvPosition.z); gl_Position = projectionMatrix * mvPosition;
              }
          `,
          fragmentShader: `
              varying vec3 vColor; varying float vAlpha;
              void main() {
                  float dist = length(gl_PointCoord - vec2(0.5)); if (dist > 0.5) discard;
                  float glow = exp(-dist * dist * 20.0); fl
